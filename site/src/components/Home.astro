---
// Home page in one language (/noirpad/ = en, /noirpad/cs/ = cs). Sections as in PLAN-noirpad.md §4.3:
// hero, features (bento with real screenshots), demo video, privacy at a glance, install, shortcuts, FAQ.
// Images come straight from docs/screenshots (demo data only), optimised by astro:assets.
import { Picture, getImage } from "astro:assets";
import heroEn from "../../../docs/screenshots/hero.png";
import heroCs from "../../../docs/screenshots/hero-cs.png";
import splitPreview from "../../../docs/screenshots/split-preview.png";
import encryption from "../../../docs/screenshots/encryption.png";
import themes from "../../../docs/screenshots/themes.png";
import palette from "../../../docs/screenshots/command-palette.png";
import demoPoster from "../assets/demo-poster.png";
import { texts, type Lang, type FeatureKey } from "../i18n/texts";
import { icon, keycaps } from "../lib/icons";
import { links, BASE, pageHref } from "../lib/links";
import { STORE, storeUrl } from "../lib/store";
import Layout from "./Layout.astro";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = texts[lang];
const store = STORE.status === "live" ? storeUrl(lang) : null;
const asset = (p: string) => `${BASE}${p}`;
const poster = await getImage({ src: demoPoster, width: 960, format: "webp", quality: 80 });

// Cards with a screenshot: a crop of the real 1280×800 shot – zoom `zoom` around `focus` (CSS transform-origin).
type ShotKey = Extract<FeatureKey, "write" | "lock" | "themes" | "command">;
type ShotCard = { key: ShotKey; img: ImageMetadata; ico: Parameters<typeof icon>[0]; focus: string; zoom: number; wide?: boolean };
const SHOTS: ShotCard[] = [
  { key: "write", img: splitPreview, ico: "FileText", focus: "60% 28%", zoom: 1.2, wide: true },
  { key: "lock", img: encryption, ico: "Lock", focus: "50% 50%", zoom: 1.75 },
  { key: "themes", img: themes, ico: "Palette", focus: "50% 50%", zoom: 1.12 },
  { key: "command", img: palette, ico: "Terminal", focus: "48% 20%", zoom: 1.45, wide: true },
];
const MINI: { key: FeatureKey; ico: Parameters<typeof icon>[0] }[] = [
  { key: "tabs", ico: "FolderTree" },
  { key: "tags", ico: "Tags" },
  { key: "search", ico: "Search" },
  { key: "export", ico: "FileDown" },
  { key: "backup", ico: "Archive" },
];
const cardSizes = (c: ShotCard) => {
  const w = c.wide ? 1060 : 520;
  // Content is 90vw wide (5vw gutters), at most 1600 px. Wide cards span two of three columns only from 1020 px;
  // between 760 and 1019 px every card is half the width.
  // Below 1020 px the shot box is 4:3, so object-fit: cover shows the 16:10 image 1.2× wider than the box;
  // box = content width − 46 px card padding/border (one column), or half of the content (two columns).
  const z = (1.2 * c.zoom).toFixed(2);
  return `(min-width: 1780px) ${Math.round(w * c.zoom)}px, (min-width: 1020px) ${Math.round((c.wide ? 60 : 30) * c.zoom)}vw, (min-width: 760px) calc((45vw - 46px) * ${z}), calc((90vw - 46px) * ${z})`;
};
// Crop of each card screenshot as a class (no inline styles – html-validate no-inline-style).
const shotCss = SHOTS.map((c) => `.shot-${c.key}{object-position:${c.focus};transform-origin:${c.focus};transform:scale(${c.zoom})}`).join("");
const POINT_ICONS = ["HardDrive", "UserX", "WifiOff"] as const;
---
<Layout lang={lang} path="" title={t.title} description={t.description}>
  <style slot="head" is:inline set:html={shotCss} />
  <main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-glow-wrap" aria-hidden="true"><div class="hero-glow"></div></div>
    <div class="hero-text">
      <h1 class="hero-title" id="hero-title">
        <span class="hero-brand">NOIRPAD<span class="cursor" aria-hidden="true"></span></span>
        <span class="sr-only"> – </span>
        <span class="hero-tagline">{t.hero.tagline}</span>
      </h1>
      {/* Decorative: the whole text is in the HTML (visible without JS); motion.ts only "types" it. */}
      <div class="typed" aria-hidden="true">
        {t.hero.typed.map((line, i) => (
          <p class:list={["typed-line", { "typed-ok": i > 0 }]} style={`--len: ${line.length}`}><span>{line}</span></p>
        ))}
      </div>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-cta">
        {store
          ? <a class="store-badge" href={store}><img src={asset(`media/store-badge-${lang}.svg`)} width="190" height="52" alt={t.hero.storeAlt} /></a>
          : <span class="store-soon">{t.hero.storeSoon}</span>}
        {/* Secondary action: the release on GitHub. The source code link stays in the footer and the navigation,
            the full SmartScreen instructions in the Install section – the line below points there. */}
        <a class="btn-secondary" href={links.latest}>{t.install.latest}<Fragment set:html={icon("ArrowRight", 15)} /></a>
      </div>
      <p class="hero-note">{t.hero.smartscreen.before}<a href="#install">{t.hero.smartscreen.link}</a>.</p>
      <p class="hero-meta">{t.hero.meta.join(" · ")}</p>
    </div>
    <div class="hero-shot">
      <div class="shot-frame">
        <Picture src={lang === "cs" ? heroCs : heroEn} widths={[480, 720, 960, 1280]} sizes="(min-width: 1440px) 1280px, 90vw"
          formats={["avif", "webp"]} fallbackFormat="png" quality={80} alt={t.hero.shotAlt} loading="eager" fetchpriority="high" decoding="async" />
        <div class="scanlines" aria-hidden="true"></div>
      </div>
    </div>
  </section>

    <section class="block" id="features" aria-labelledby="features-title">
      <header class="block-head" data-reveal>
        <p class="eyebrow">{t.features.eyebrow}</p>
        <h2 id="features-title">{t.features.title}</h2>
        <p class="section-lead">{t.features.lead}</p>
      </header>
      <div class="bento">
        {SHOTS.map((c) => (
          <article class:list={["card", { "card-wide": c.wide }]} data-reveal>
            <div class="card-head">
              <span class="card-icon" set:html={icon(c.ico, 18)} />
              <h3>{t.features.cards[c.key].title}</h3>
            </div>
            <p>{t.features.cards[c.key].text}</p>
            <div class="card-shot">
              <Picture src={c.img} widths={[480, 640, 800, 960, 1120, 1280]} sizes={cardSizes(c)} formats={["avif", "webp"]}
                fallbackFormat="jpg" quality={78} alt={t.features.cards[c.key].alt} loading="lazy" decoding="async"
                class={`shot-${c.key}`} />
            </div>
          </article>
        ))}
      </div>
      <ul class="mini">
        {MINI.map((c) => (
          <li class="card mini-card" data-reveal>
            <span class="card-icon" set:html={icon(c.ico, 18)} />
            <h3>{t.features.cards[c.key].title}</h3>
            <p>{t.features.cards[c.key].text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="block video" aria-labelledby="video-title">
      <header class="block-head" data-reveal>
        <p class="eyebrow">{t.demo.eyebrow}</p>
        <h2 id="video-title">{t.demo.title}</h2>
        <p class="section-lead">{t.demo.lead}</p>
      </header>
      <div class="frame">
        {/* Without JS the native controls are visible; JS hides them, plays the video only while it is on
            screen and adds a pause button. With "reduce motion" nothing plays by itself – just the poster. */}
        <video id="demo-video" width="960" height="600" muted loop playsinline controls preload="none"
          poster={poster.src} aria-label={t.demo.label}>
          <source src={asset("media/noirpad-demo.webm")} type="video/webm" />
          <source src={asset("media/noirpad-demo.mp4")} type="video/mp4" />
        </video>
        <div class="scanlines" aria-hidden="true"></div>
        <button type="button" class="vtoggle" id="demo-toggle" hidden data-play={t.demo.play} data-pause={t.demo.pause} aria-label={t.demo.pause}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="i-pause"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="i-play"><path fill="currentColor" d="M8 5.5v13l10.5-6.5z"/></svg>
        </button>
      </div>
    </section>

    <section class="block" id="privacy" aria-labelledby="privacy-title">
      <header class="block-head" data-reveal>
        <p class="eyebrow">{t.privacy.eyebrow}</p>
        <h2 id="privacy-title">{t.privacy.title}</h2>
      </header>
      <ul class="points">
        {t.privacy.points.map((p, i) => (
          <li class="card point" data-reveal>
            <span class="card-icon" set:html={icon(POINT_ICONS[i], 18)} />
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
      <div class="lockbox card" data-reveal>
        <div class="lockbox-text">
          <h3><Fragment set:html={icon("KeyRound", 18)} />{t.privacy.lockTitle}</h3>
          <p>{t.privacy.lockLead}</p>
          <p class="warn">{t.privacy.warning}</p>
          <a class="more" href={pageHref(lang, "privacy/")}>{t.privacy.more}<Fragment set:html={icon("ArrowRight", 15)} /></a>
        </div>
        <div class="lockbox-cols">
          <div class="col col-yes">
            <h4>{t.privacy.encrypted}</h4>
            <ul>{t.privacy.encryptedItems.map((x) => <li><Fragment set:html={icon("Lock", 15)} />{x}</li>)}</ul>
          </div>
          <div class="col col-no">
            <h4>{t.privacy.notEncrypted}</h4>
            <ul>{t.privacy.notEncryptedItems.map((x) => <li><Fragment set:html={icon("X", 15)} />{x}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <section class="block" id="install" aria-labelledby="install-title">
      <header class="block-head" data-reveal>
        <p class="eyebrow">{t.install.eyebrow}</p>
        <h2 id="install-title">{t.install.title}</h2>
        <p class="section-lead">{t.install.lead}</p>
      </header>
      <div class="install card" data-reveal>
        <div class="install-main">
          {store
            ? <a class="store-badge" href={store}><img src={asset(`media/store-badge-${lang}.svg`)} width="190" height="52" alt={t.hero.storeAlt} loading="lazy" /></a>
            : <span class="store-soon">{t.hero.storeSoon}</span>}
          <a class="btn-secondary" href={links.latest}>{t.install.latest}<Fragment set:html={icon("ArrowRight", 15)} /></a>
          <p class="small">{t.install.smartscreen}</p>
        </div>
        <div class="install-req">
          <h3>{t.install.reqTitle}</h3>
          <ul>{t.install.req.map((r) => <li><Fragment set:html={icon("Check", 15)} />{r}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="block shortcuts" id="shortcuts" aria-labelledby="shortcuts-title">
      <header class="block-head" data-reveal>
        <p class="eyebrow">{t.shortcuts.eyebrow}</p>
        <h2 id="shortcuts-title">{t.shortcuts.title}</h2>
        <p class="section-lead">{t.shortcuts.lead}</p>
      </header>
      <ul class="keys">
        {t.shortcuts.main.map((s) => (
          <li data-reveal><span class="keycaps" set:html={keycaps(s.keys)} /><span class="key-action">{s.action}</span></li>
        ))}
      </ul>
      <details class="all-keys" data-reveal>
        <summary>{t.shortcuts.all}</summary>
        <table>
          <thead><tr><th scope="col">{t.shortcuts.keyCol}</th><th scope="col">{t.shortcuts.actionCol}</th></tr></thead>
          <tbody>
            {[...t.shortcuts.main, ...t.shortcuts.rest].map((s) => <tr><td set:html={keycaps(s.keys)} /><td>{s.action}</td></tr>)}
          </tbody>
        </table>
      </details>
    </section>

    <section class="block faq" id="faq" aria-labelledby="faq-title">
      <header class="block-head" data-reveal>
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2 id="faq-title">{t.faq.title}</h2>
      </header>
      <div class="faq-list">
        {t.faq.items.map((f, i) => (
          <details name="faq" open={i === 0} data-reveal>
            <summary>{f.q}<span class="faq-plus" aria-hidden="true" /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <script>
    // Demo video (preload="none", poster in the HTML): plays only while on screen. Pause button (WCAG 2.2.2);
    // with "reduce motion" nothing plays by itself – the poster and the native controls stay.
    const video = document.getElementById("demo-video") as HTMLVideoElement | null;
    const toggle = document.getElementById("demo-toggle") as HTMLButtonElement | null;
    if (video && toggle && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let paused = false; // paused by the visitor
      const sync = () => {
        const playing = !video.paused;
        toggle.classList.toggle("is-paused", !playing);
        toggle.setAttribute("aria-label", playing ? toggle.dataset.pause! : toggle.dataset.play!);
      };
      const play = () => video.play().catch(() => { video.controls = true; toggle.hidden = true; });
      video.controls = false;
      toggle.hidden = false;
      video.addEventListener("play", sync);
      video.addEventListener("pause", sync);
      toggle.addEventListener("click", () => {
        paused = !video.paused;
        if (paused) video.pause(); else play();
      });
      if ("IntersectionObserver" in window) {
        new IntersectionObserver((entries) => {
          const visible = entries.some((e) => e.isIntersecting);
          if (visible && !paused) play();
          else if (!visible) video.pause();
        }, { rootMargin: "200px" }).observe(video);
      } else play();
    }
  </script>
</Layout>
