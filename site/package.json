{
  "name": "noirpad-site",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare.mjs",
    "predev": "node scripts/prepare.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/check-words.mjs",
    "preview": "astro preview",
    "check:words": "node scripts/check-words.mjs",
    "check:types": "astro check",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:seo": "node scripts/check-seo.mjs",
    "check:all": "npm run check:types && npm run build && npm run check:html && npm run check:seo && npm run check:overflow",
    "og": "node scripts/og.mjs",
    "make:media": "node scripts/make-media.mjs",
    "check:overflow": "node scripts/check-overflow.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "astro": "^7.3.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "html-validate": "^11.18.0",
    "lucide": "^1.66.0",
    "node-html-parser": "^9.0.6",
    "playwright-core": "^1.64.1",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
