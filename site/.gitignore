# The repo root .gitignore already covers node_modules/ and dist/. build.ps1 of the app refuses to run
# with a dirty git status, so everything the website generates must be ignored here.
.astro/
# The root .gitignore ignores any folder named images/ or build/ (app data and PyInstaller output) –
# inside the website such folders are sources, so they are tracked again.
!images/
!build/
# Generated by scripts/prepare.mjs (Czech font subsets)
public/fonts/
# Generated by scripts/prepare.mjs (favicons and manifest icons from docs/brand)
public/favicon.svg
public/favicon.ico
public/apple-touch-icon.png
public/icon-192.png
public/icon-512.png
public/icon-maskable-512.png
